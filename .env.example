# Math Quest Environment Variables
# Duplicate this file to .env and insert your personal API keys

# Google Gemini API Key (Required for online generation - free tier available at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq API Key (Optional - used for offline evaluation benchmark at console.groq.com)
GROQ_API_KEY=

# ── Turso (libSQL) Cloud Database ────────────────────────────────────────────
# Required for production / Vercel deployment so user data persists.
# Leave BLANK for local development — the app falls back to a local SQLite file.
#
# 1. Sign up free at https://turso.tech/
# 2. Create a database:  turso db create quest-users
# 3. Get the URL:        turso db show quest-users --url
# 4. Create a token:     turso db tokens create quest-users
#
