{
  "framework": null,
  "buildCommand": "npx nuxt generate",
  "outputDirectory": ".output/public",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/200.html"
    }
  ]
}
